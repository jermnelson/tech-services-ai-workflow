@prefix bf: <http://id.loc.gov/ontologies/bibframe/> .
@prefix bflc: <http://id.loc.gov/ontologies/bflc/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<big:FrequencyShape> a sh:NodeShape ;
    rdfs:label "Frequency" ;
    sh:property [ a sh:PropertyShape ;
            rdfs:label "Frequency" ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass bf:Frequency .

<big:PubFrequencyShape> a sh:NodeShape ;
    rdfs:label "Frequency" ;
    sh:property [ a sh:PropertyShape ;
            rdfs:label "Publication Frequency" ;
            sh:minCount 1 ;
            sh:path bf:frequency ;
            sh:severity sh:Warning ] ;
    sh:targetClass bf:PubFrequency .

<big:Serial:Instance:Electronic> a sh:NodeShape ;
    rdfs:label "Instance (Serial) Electronic" ;
    sh:property [ a sh:PropertyShape ;
            rdfs:label "Administrative metadata" ;
            sh:minCount 1 ;
            sh:node <big:AdminMetadata> ;
            sh:path bf:adminMetadata ;
            sh:severity sh:Violation ],
        [ a sh:PropertyShape ;
            rdfs:label "Instance Title" ;
            sh:minCount 1 ;
            sh:node <big:Title> ;
            sh:path bf:title ;
            sh:severity sh:Violation ],
        [ a sh:PropertyShape ;
            rdfs:label "Media type" ;
            sh:minCount 1 ;
            sh:path bf:media ;
            sh:severity sh:Violation ],
        [ a sh:PropertyShape ;
            rdfs:label "Digital Characteristic" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node <big:DigitalCharacteristic> ;
            sh:path bf:digitalCharacteristic ;
            sh:severity sh:Warning ],
        [ a sh:PropertyShape ;
            rdfs:label "Mode of Issuance" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path bf:issuance ;
            sh:severity sh:Violation ],
        [ a sh:PropertyShape ;
            rdfs:label "Identifiers" ;
            sh:minCount 1 ;
            sh:node <big:SerialIdentifier> ;
            sh:path bf:identifiedBy ;
            sh:severity sh:Warning ],
        [ a sh:PropertyShape ;
            rdfs:label "Uniform Resource Locator for resource" ;
            sh:minCount 1 ;
            sh:path bf:electronicLocator ;
            sh:severity sh:Warning ],
        [ a sh:PropertyShape ;
            rdfs:label "Provision Activity--Publication Information" ;
            sh:minCount 1 ;
            sh:node <big:ProvisionActivity> ;
            sh:path bf:provisionActivity ;
            sh:severity sh:Violation ],
        [ a sh:PropertyShape ;
            rdfs:label "Publication frequency" ;
            sh:minCount 1 ;
            sh:node <big:PubFrequency> ;
            sh:path bf:pubfrequency ;
            sh:severity sh:Warning ],
        [ a sh:PropertyShape ;
            rdfs:label "Carrier type" ;
            sh:minCount 1 ;
            sh:path bf:carrier ;
            sh:severity sh:Violation ],
        [ a sh:PropertyShape ;
            rdfs:label "Instance of" ;
            sh:minCount 1 ;
            sh:node <big:Serial:Work> ;
            sh:path bf:instanceOf ;
            sh:severity sh:Violation ] ;
    sh:targetClass bf:Electronic .

<big:Agent> a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:label "Agent Label" ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass bf:Agent,
        bf:Family,
        bf:Jurisdiction,
        bf:Meeting,
        bf:Organization,
        bf:Person .

<big:DigitalCharacteristic> a sh:NodeShape ;
    rdfs:label "Digital Characteristic" ;
    sh:property [ a sh:PropertyShape ;
            rdfs:label "File Type" ;
            sh:minCount 1 ;
            sh:path bf:digitalCharacteristic ;
            sh:severity sh:Warning ],
        [ a sh:PropertyShape ;
            rdfs:label "Encoding Format" ;
            sh:minCount 1 ;
            sh:path bf:digitalCharacteristic ;
            sh:severity sh:Warning ] ;
    sh:targetClass bf:EncodingFormat,
        bf:FileType .

<big:Place> a sh:NodeShape ;
    sh:property [ a sh:PropertyShape ;
            rdfs:label "Place Label" ;
            sh:minCount 1 ;
            sh:path rdfs:label ;
            sh:severity sh:Warning ] ;
    sh:targetClass bf:Place .

<big:ProvisionActivity> a sh:NodeShape ;
    rdfs:label "Provision Activity" ;
    sh:property [ a sh:PropertyShape ;
            rdfs:label "Agent" ;
            sh:minCount 1 ;
            sh:node <big:Agent> ;
            sh:path bf:agent ;
            sh:severity sh:Warning ],
        [ a sh:PropertyShape ;
            rdfs:label "Date" ;
            sh:minCount 1 ;
            sh:path bf:date ;
            sh:severity sh:Warning ],
        [ a sh:PropertyShape ;
            rdfs:label "Place Simple Label" ;
            sh:minCount 1 ;
            sh:path bflc:simplePlace ;
            sh:severity sh:Warning ],
        [ a sh:PropertyShape ;
            rdfs:label "Simple Date" ;
            sh:minCount 1 ;
            sh:path bflc:simpleDate ;
            sh:severity sh:Warning ],
        [ a sh:PropertyShape ;
            rdfs:label "Place" ;
            sh:minCount 1 ;
            sh:node <big:Place> ;
            sh:path bf:place ;
            sh:severity sh:Warning ],
        [ a sh:PropertyShape ;
            rdfs:label "Agent Simple Label" ;
            sh:minCount 1 ;
            sh:path bflc:simpleAgent ;
            sh:severity sh:Warning ] ;
    sh:targetClass bf:Distribution,
        bf:Manufacture,
        bf:Modification,
        bf:Production,
        bf:ProvisionActivity,
        bf:Publication .

<big:SerialIdentifier> a sh:NodeShape ;
    rdfs:label "Identifier" ;
    sh:property [ a sh:PropertyShape ;
            rdfs:label "Serial Identifier" ;
            sh:minCount 1 ;
            sh:path rdf:value ;
            sh:severity sh:Warning ] ;
    sh:targetClass bf:Issn,
        bf:IssnL .

<big:Title> a sh:NodeShape ;
    rdfs:label "Title" ;
    sh:property [ a sh:PropertyShape ;
            rdfs:label "Main Title" ;
            sh:minCount 1 ;
            sh:path bf:mainTitle ;
            sh:severity sh:Violation ] ;
    sh:targetClass bf:Title .

